{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "mcp__deciduous",
      "mcp__tidewave"
    ],
    "ask": [
      "Bash(gh pr comment:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue create:*)",
      "Bash(gh release create:*)",
      "Bash(git push:*)",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_send_message_draft",
      "mcp__claude_ai_Slack__slack_schedule_message",
      "mcp__claude_ai_Slack__slack_add_reaction",
      "mcp__claude_ai_Slack__slack_create_canvas",
      "mcp__claude_ai_Slack__slack_update_canvas",
      "mcp__claude_ai_Slack__slack_create_conversation",
      "mcp__plugin_Notion_notion__notion-create-comment",
      "mcp__plugin_Notion_notion__notion-create-pages",
      "mcp__plugin_Notion_notion__notion-update-page",
      "mcp__plugin_Notion_notion__notion-move-pages"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/gh-write-guard.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "~/.claude/bin/aws-write-guard.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/bin/worktree-edit-guard.sh \"$PPID\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/agent-status --agent claude clear 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/agent-status --agent claude working 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/agent-status --agent claude waiting 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/agent-status --agent claude done 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c '\"/Users/nvieirafelipe/.asdf/installs/nodejs/22.19.0/bin/node\" \"$(ls -td ~/.claude/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | head -1)dist/index.js\"'"
  },
  "enabledPlugins": {
    "elixir-lsp@claude-code-elixir": true,
    "claude-hud@claude-hud": true,
    "lua-lsp@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "caveman@caveman": true,
    "chrome-devtools-mcp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      },
      "autoUpdate": true
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "claude-code-elixir": {
      "source": {
        "source": "github",
        "repo": "georgeguimaraes/claude-code-elixir"
      }
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "advisorModel": "fable",
  "tui": "default",
  "skipWorkflowUsageWarning": true,
  "theme": "custom:tn-purple",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
