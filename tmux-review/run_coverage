#!/usr/bin/env bash
set -uo pipefail

# Line coverage for the plugin, with nothing to install.
#
#   run_coverage              report
#   run_coverage --min 100    report, and exit 1 under that percentage
#   run_coverage --missing    report, and list every uncovered line
#   run_coverage --scope unit what the tests reach without the live sections
#
# Measured, the two are the same number, and the difference is the point: the
# live sections do their work inside processes the tmux server starts, and that
# server inherits neither the xtrace setting nor the descriptor the trace is
# written to. A line only ever reached by pressing a key at a real review is
# therefore not counted here however thoroughly it runs -- delete_comment read
# 0 of 19 while the end to end section was demonstrably deleting comments.
#
# So this figure is a unit-coverage figure whatever the scope says, and --scope
# unit is the honest way to ask for it. The live sections are a correctness
# net, not a contributor here; do not read their absence from this report as
# their not having run.
#
# bash's own xtrace is the instrument, with PS4 rewritten to name the file and
# the line of each command it runs and BASH_XTRACEFD sending that stream to a
# file rather than stderr. It is the same mechanism kcov uses for shell, minus
# the part that rewrites the script: kcov 43 mis-parses `coproc NAME { ... }`,
# loses track of the brace, and runs the rest of the enclosing function at
# parse time -- which start_subscription does not survive. See README.
#
# SHELLOPTS is readonly in a running shell, but bash enables what it lists when
# it is in the environment at startup, and fd 9 survives exec: so the scripts
# the suite runs as commands are measured too, not only the ones it sources.
#
# PS4 starts with a + that carries no meaning: bash repeats the first character
# of PS4 once per level of nesting, and with the field separator first that
# repetition lands inside the separator and the file name is lost.

here=$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)
min=0 show_missing=0 scope=all
while (($#)); do
  case $1 in
    --min) min=${2:?a percentage}; shift 2 ;;
    --missing) show_missing=1; shift ;;
    --scope) scope=${2:?all or unit}; shift 2 ;;
    *) echo "usage: run_coverage [--min <pct>] [--missing] [--scope all|unit]" >&2
       exit 64 ;;
  esac
done
case $scope in
  all | unit) ;;
  *) echo "usage: --scope takes all or unit" >&2; exit 64 ;;
esac

trace=$(mktemp -t review-cov)
trap 'rm -f "$trace"' EXIT

exec 9>|"$trace"
# PS4 is expanded by the shell being traced, not by this one, so the single
# quotes are the point.
# shellcheck disable=SC2016
env SHELLOPTS=xtrace BASH_XTRACEFD=9 REVIEW_TEST_SCOPE="$scope" \
  PS4='+@@${BASH_SOURCE}@@${LINENO}@@' \
  bash -c 'source "$1/tests/review_test.sh"' _ "$here" >/dev/null 2>&1
exec 9>&-

# LC_ALL=C because the scan below walks lines a character at a time, and the
# awk macOS ships gives up on the first byte it cannot decode -- which a glyph
# written out as raw bytes is. Quotes and parentheses are all ASCII, so reading
# bytes loses nothing.
LC_ALL=C awk -v trace="$trace" -v missing="$show_missing" -v min="$min" -v scope="$scope" '
  # A line xtrace can emit for: not blank, not a comment, and not one of the
  # bare keywords that close or continue a compound command -- bash traces the
  # commands inside those, never the keyword itself.
  function executable(s) {
    if (s == "" || s ~ /^#/) return 0
    # Keywords, with or without a redirection hung off them: bash traces the
    # commands a compound statement contains, never the words that delimit it,
    # so `done < <(git log ...)` is no more reachable than a bare `done`.
    if (s ~ /^(fi|done|esac|else|then|do|\}|\{|;;|\)|\(|\|\||&&)([ \t;<>&|]|$)/) return 0
    if (s ~ /^[A-Za-z_][A-Za-z0-9_]*[ \t]*\([ \t]*\)[ \t]*\{?$/) return 0
    return 1
  }
  function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
  function base(p) { sub(/.*\//, "", p); return p }

  # Whether the command a line is part of carries on past it: a quote or a
  # $( ) still open, or a backslash at the end. The states are the quoting a
  # line of shell can be in -- single, double, $'...', and the parentheses of
  # $( ), <( ) and >( ) with whatever nests inside them -- kept on a stack
  # across the lines of one command. A # that starts a word ends the line.
  function scan(line,   i, n, c, top, prev, tail) {
    if (!open) { sp = 1; st[1] = "code" }
    n = length(line); tail = 0
    for (i = 1; i <= n; i++) {
      c = substr(line, i, 1); top = st[sp]
      if (top == "single") { if (c == q) sp--; continue }
      if (c == "\\") { if (i == n) tail = 1; i++; continue }
      if (top == "ansi") { if (c == q) sp--; continue }
      if (top == "double") {
        if (c == "\"") sp--
        else if (c == "$" && substr(line, i + 1, 1) == "(") { st[++sp] = "paren"; i++ }
        continue
      }
      if (c == "#") {
        prev = i == 1 ? " " : substr(line, i - 1, 1)
        if (prev ~ /[ \t;&|(]/) break
        continue
      }
      if (c == q) st[++sp] = "single"
      else if (c == "\"") st[++sp] = "double"
      else if (c == "$" && substr(line, i + 1, 1) == q) { st[++sp] = "ansi"; i++ }
      else if (c ~ /[$<>]/ && substr(line, i + 1, 1) == "(") { st[++sp] = "paren"; i++ }
      else if (top == "paren" && c == "(") st[++sp] = "paren"
      else if (top == "paren" && c == ")") sp--
    }
    return sp > 1 || tail
  }

  # A script run through a symlink is traced under the path of the link, and
  # the link is usually gone by the time this reads the trace -- tests make
  # them in temporary directories. Such a path is credited to the measured
  # file of the same name, when exactly one has that name and the path is not
  # a real file of its own.
  function credit(p,   b) {
    if (p in measured) return p
    if (p in resolved) return resolved[p]
    b = base(p)
    resolved[p] = p
    if (named[b] != "" &&
        system("[ ! -f \"" p "\" ] || [ -L \"" p "\" ]") == 0) resolved[p] = named[b]
    return resolved[p]
  }

  BEGIN {
    q = "\047"
    for (i = 2; i < ARGC; i++) {
      measured[ARGV[i]] = 1
      b = base(ARGV[i])
      named[b] = (b in named) ? "" : ARGV[i]
    }
  }

  FILENAME == trace {
    n = split($0, part, "@@")
    for (i = 2; i + 1 <= n; i += 2)
      if (part[i] ~ /^\//) hit[credit(part[i]) ":" part[i+1]] = 1
    next
  }

  FNR == 1 { file = FILENAME; depth = 0; fn = ""; heredoc = ""; array = 0; open = 0; head = ""; incase = 0 }
  {
    s = trim($0)

    # A heredoc body is data, not commands.
    if (heredoc != "") {
      if (s == heredoc) heredoc = ""
      next
    }

    # A command over several lines is one candidate, at its first line, and
    # reached if xtrace named any of them. Which one it names is not fixed:
    # the first line for a quoted program handed to awk or jq, the last for a
    # $( ) continued with a backslash, the line a <( opens on for everything
    # inside it. Counting each line on its own put a floor under the miss
    # column that no test could ever lift.
    if (open) {
      if (head != "" && (file ":" FNR) in hit) reached[head] = 1
      open = scan($0)
      next
    }

    if (match(s, /<<-?[ \t]*['"'"'"]?[A-Za-z_][A-Za-z0-9_]*/)) {
      tag = substr(s, RSTART, RLENGTH)
      sub(/^<<-?[ \t]*['"'"'"]?/, "", tag)
      heredoc = tag
    }

    # Elements of a multi-line array assignment are words of one command.
    if (array) { if (s ~ /^\)/) array = 0; next }
    if (s ~ /^[A-Za-z_][A-Za-z0-9_]*(\+)?=\([^)]*$/) { array = 1; next }

    # Function spans, by brace depth, so a miss can be named rather than
    # numbered. Only top-level definitions: nothing here nests them.
    if (fn == "" && s ~ /^[A-Za-z_][A-Za-z0-9_]*[ \t]*\([ \t]*\)[ \t]*\{$/) {
      fn = s; sub(/[ \t]*\(.*/, "", fn); depth = 1; start[fn] = FNR; next
    }
    if (fn != "") {
      d = gsub(/\{/, "{", $0) - gsub(/\}/, "}", $0)
      depth += d
      if (depth <= 0) { fn = "" }
    }

    # A case arm whose pattern has a line to itself: bash traces the commands
    # under it, never the pattern.
    if (s ~ /^esac([ \t;]|$)/) incase--
    if (incase > 0 && s ~ /^[^$=()#]*\)[ \t]*(#.*)?$/) { head = ""; open = scan($0); next }

    head = ""
    if (executable(s)) {
      head = file ":" FNR
      order[file, ++count[file]] = FNR
      owner[head] = fn
      if (head in hit) reached[head] = 1
      if (s ~ /(^|[ \t;&|])case[ \t].*[ \t]in([ \t]*#.*)?$/) incase++
    }
    open = scan($0)
  }

  END {
    total = 0; covered = 0
    for (f in count) {
      for (k = 1; k <= count[f]; k++) {
        l = order[f, k]; key = f ":" l; fn = owner[key]
        cand[f]++
        if (fn != "") fcand[f "\x1f" fn]++
        if (key in reached) {
          ok[f]++
          if (fn != "") fok[f "\x1f" fn]++
        } else {
          gap[f] = gap[f] " " l
          if (fn != "") fgap[f "\x1f" fn] = fgap[f "\x1f" fn] " " l
        }
      }
    }
    for (f in cand) {
      total += cand[f]; covered += ok[f]
      name = f; sub(/.*\//, "", name)
      printf "\n%-18s %4d/%-4d  %5.1f%%\n", name, ok[f], cand[f], 100 * ok[f] / cand[f]
      for (k in fcand) {
        split(k, p, "\x1f")
        if (p[1] != f) continue
        if (fok[k] == fcand[k]) continue
        printf "  %-24s %3d/%-3d%s\n", p[2], fok[k] + 0, fcand[k], missing ? "  miss:" fgap[k] : ""
      }
      if (missing && gap[f] != "") printf "  %-24s %s\n", "(all uncovered)", gap[f]
    }
    pct = total ? 100 * covered / total : 100
    printf "\n%-18s %4d/%-4d  %5.1f%%   (scope: %s)\n", "TOTAL", covered, total, pct, scope
    if (min > 0 && pct + 0.0001 < min) {
      printf "\nbelow the %s%% this is required to hold\n", min
      exit 1
    }
  }
' "$trace" "$here"/scripts/*.sh "$here"/bin/git-review "$here"/review.tmux
