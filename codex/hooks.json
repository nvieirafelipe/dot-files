{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/agent-status --agent codex working 2>/dev/null || true",
            "statusMessage": "tmux: working"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/agent-status --agent codex waiting 2>/dev/null || true",
            "statusMessage": "tmux: waiting"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/agent-status --agent codex done 2>/dev/null || true",
            "statusMessage": "tmux: done"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/agent-status --agent codex clear 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/agent-status --agent codex clear 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
