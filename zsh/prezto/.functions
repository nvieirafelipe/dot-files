# j <pattern> — jump to first dir matching <pattern> under ~/Developer (depth 2).
# Case-insensitive substring match. Zero dependencies (find builtin only).
#   j dot  -> cd ~/Developer/dot-files
j() {
  local dir
  dir=$(find ~/Developer -maxdepth 2 -type d -iname "*$1*" -print -quit 2>/dev/null)
  if [[ -n $dir ]]; then
    cd "$dir"
  else
    echo "j: no match for '$1' under ~/Developer" >&2
    return 1
  fi
}

# jp <pattern> — like j, but lists all matches and lets you pick one.
# Uses zsh/bash `select` builtin. Zero dependencies.
jp() {
  local dirs=( ${(f)"$(find ~/Developer -maxdepth 2 -type d -iname "*$1*" 2>/dev/null)"} )
  if (( ${#dirs} == 0 )); then
    echo "jp: no match for '$1' under ~/Developer" >&2
    return 1
  fi
  local choice
  select choice in "${dirs[@]}"; do
    [[ -n $choice ]] && { cd "$choice"; break; }
  done
}
