#
# Shell functions. Sourced from .zshrc alongside .aliases.
#
# Authors:
#   Felipe Vieira <nvieirafelipe@gmail.com>
#

# j <pattern> — jump to first dir matching <pattern> under ~/Developer (depth 2).
# Case-insensitive substring match. Zero dependencies (find builtin only).
#   j dot  -> cd ~/Developer/dot-files
j() {
  local dir
  dir=$(find ~/Developer -maxdepth 2 -type d -iname "*$1*" -print -quit 2>/dev/null)
  if [[ -n $dir ]]; then
    cd "$dir"
  else
    echo "j: no match for '$1' under ~/Developer" >&2
    return 1
  fi
}

# jp <pattern> — like j, but lists all matches and lets you pick one.
# Uses zsh/bash `select` builtin. Zero dependencies.
jp() {
  local dirs=( ${(f)"$(find ~/Developer -maxdepth 2 -type d -iname "*$1*" 2>/dev/null)"} )
  if (( ${#dirs} == 0 )); then
    echo "jp: no match for '$1' under ~/Developer" >&2
    return 1
  fi
  local choice
  select choice in "${dirs[@]}"; do
    [[ -n $choice ]] && { cd "$choice"; break; }
  done
}

# A random Tokyo Night Storm accent for every Claude Code session, so several
# running side by side are tellable apart at a glance.
#
# The colour cannot live in settings.json: every session in a directory reads
# the same file, so they would fight over it. --settings takes JSON inline and
# applies to one invocation only, which is exactly the scope wanted, and writes
# nothing. The themes themselves are installed once by
# claude/bin/session-theme.sh -- keep this list in step with its palette.
#
# Settings that must stay out of this public repo, such as an employer's auto
# mode rules and plugins, live in an untracked ~/.claude/settings.work.json.
# Claude Code reads autoMode only from the user file, managed settings or
# --settings, so that file rides in on --settings too. A second --settings
# replaces the first rather than merging with it, so both go in one object:
# the file's outer braces are dropped and its keys follow the theme's.
#
# Pure shell on purpose: an array index, one file read and a few expansions,
# no external command, since this sits in front of every launch. The theme only
# when interactive; the work settings always, so scripts keep the same auto
# mode rules. A --settings of your own replaces both, so one-off overrides are
# left alone.
claude() {
  if [[ " $* " == *' --settings '* ]]; then
    command claude "$@"
    return
  fi

  local -a fields=()
  if [[ -o interactive ]]; then
    local -a pool=(
      tn-red tn-orange tn-yellow tn-green tn-teal
      tn-cyan tn-blue tn-blue1 tn-purple tn-magenta
    )
    fields+=("\"theme\":\"custom:${pool[RANDOM % $#pool + 1]}\"")
  fi

  local work=~/.claude/settings.work.json body
  if [[ -f $work ]]; then
    body=${${"$(<$work)"}#*\{}
    body=${body%\}*}
    [[ -n ${body//[[:space:]]/} ]] && fields+=("$body")
  fi

  if (( $#fields )); then
    command claude --settings "{${(j:,:)fields}}" "$@"
  else
    command claude "$@"
  fi
}
